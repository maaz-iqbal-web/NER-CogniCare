# Copy this file to .env and add your own API key.
OPENAI_API_KEY=
# You can change the model if your account uses another supported model.
OPENAI_MODEL=gpt-5.6-luna
# Keep true for safe local fallback when the API key is missing/unavailable.
AI_LOCAL_FALLBACK=true
# 4-digit PIN caregivers enter to unlock the caregiver dashboard (trends, notes, session history).
# Change this before any real deployment.
CAREGIVER_PIN=1234
# Random secret used to sign the caregiver's session cookie. Set a long random value in production.
SECRET_KEY=change-me-in-production
